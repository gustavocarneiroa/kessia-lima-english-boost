NODE_ENV=development
PORT=3200
HOST=127.0.0.1

# Banco
DATABASE_PATH=./data/kessia.db
# AUDIO_DIR=./data/audio

# Front
PUBLIC_WEB_ORIGIN=https://www.teacherkessialima.com.br
EXTRA_CORS_ORIGINS=http://localhost:8080

# Auth
JWT_SECRET=

# Domínio de e-mail que identifica professora (qualquer outro e-mail é tratado como aluno)
TEACHER_EMAIL_DOMAIN=teacherkessialima.com.br
ADMIN_EMAIL=kessialima@teacherkessialima.com.br

# WebAuthn (login por dispositivo/passkey) — RP_ID precisa ser o domínio do front, sem porta/protocolo
WEBAUTHN_RP_ID=teacherkessialima.com.br
WEBAUTHN_RP_NAME=Teacher Kessia Lima
